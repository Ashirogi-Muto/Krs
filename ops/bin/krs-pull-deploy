#!/bin/bash
# Pull-only deploy for the KRS server. The server never builds, installs packages or stages anything:
# GitHub Actions builds the images, this script only pulls finished code (ops files) and images, then restarts.
# The server is a shared host (Oracle, arm64): it changes nothing host-wide (no Docker daemon config or restart,
# no sysctl, no TRIM schedule, no host nginx). TLS and routing are done by Nginx Proxy Manager (docs/NEW-SERVER.md).
#
#   sudo krs-pull-deploy --init       first run on a new server: also creates the env files with new random secrets
#                                     and the finance databases (see docs/NEW-SERVER.md)
#   sudo krs-pull-deploy              normal update: pull the branch, install changed ops files, deploy any new images
#   sudo krs-pull-deploy --status     show what is running; changes nothing
# Options:
#   --website <tag>|skip   website image tag (default: the branch's moving tag, i.e. main); sha-<commit> pins one
#   --finance <tag>|skip   same for the finance portals
#   --ops-only             only update ops files (scripts, timers, compose files), deploy no images
#
# Settings (optional) in /opt/krs/deploy/deploy.conf:  BRANCH=main  REPO_DIR=/opt/krs/repo
# Production comes from main only (owner, 10 Oct 2026): images are built only for main (GitHub Actions).
# An image whose ID is already running is skipped, so running this twice in a row restarts nothing.
set -u
umask 022
CONF=/opt/krs/deploy/deploy.conf
[ -r "$CONF" ] && source "$CONF"
REPO_DIR=${REPO_DIR:-/opt/krs/repo}
BRANCH=${BRANCH:-main}
DEPLOY=/opt/krs/deploy
SITE_URL=https://kalamroboticssociety.com

log()  { echo "[pull-deploy] $*"; logger -t krs-health -p user.notice "pull-deploy: $*" 2>/dev/null || true; }
die()  { echo "[pull-deploy] ERROR: $*" >&2; logger -t krs-health "WARN pull-deploy failed: $*" 2>/dev/null || true; exit 1; }

ARGS=("$@"); INIT=0; STATUS=0; OPS_ONLY=0; WEB_TAG=""; FIN_TAG=""
while [ $# -gt 0 ]; do
  case "$1" in
    --init) INIT=1;; --status) STATUS=1;; --ops-only) OPS_ONLY=1;;
    --website) WEB_TAG=${2:?--website needs a tag or skip}; shift;;
    --finance) FIN_TAG=${2:?--finance needs a tag or skip}; shift;;
    -h|--help) sed -n '2,19p' "$0"; exit 0;;
    *) die "unknown option $1 (see --help)";;
  esac; shift
done
[ "$(id -u)" = 0 ] || die "run with sudo"
MOVING=main   # the only moving image tag (images are built only for main)
WEB_TAG=${WEB_TAG:-$MOVING}; FIN_TAG=${FIN_TAG:-$MOVING}

if [ $STATUS = 1 ]; then
  echo "repo:     $REPO_DIR @ $(git -C "$REPO_DIR" rev-parse --short HEAD 2>/dev/null) (branch $BRANCH)"
  for i in krs-website krs-finance-backend krs-finance-frontend; do
    printf '%-22s latest=%s  prev=%s  commit=%s\n' "$i" \
      "$(docker image inspect -f '{{.Id}}' $i:latest 2>/dev/null | cut -c8-19 || echo -)" \
      "$(docker image inspect -f '{{.Id}}' $i:prev 2>/dev/null | cut -c8-19 || echo -)" \
      "$(docker image inspect -f '{{index .Config.Labels "org.opencontainers.image.revision"}}' $i:latest 2>/dev/null | cut -c1-7)"
  done
  docker ps --format '{{.Names}}\t{{.Status}}' | grep -E '^krs-' || true
  exit 0
fi

# --- 1. Pull the code (only a git fetch; nothing is built). Then re-run the freshly pulled copy of this script. ---
if [ -z "${KRS_PULLED:-}" ]; then
  [ -d "$REPO_DIR/.git" ] || die "$REPO_DIR is not a git checkout (see docs/NEW-SERVER.md step 3)"
  git -C "$REPO_DIR" fetch -q origin "$BRANCH" || die "git fetch failed (deploy key? network?)"
  old=$(git -C "$REPO_DIR" rev-parse --short HEAD)
  git -C "$REPO_DIR" checkout -q -B "$BRANCH" "origin/$BRANCH" && git -C "$REPO_DIR" reset -q --hard "origin/$BRANCH" \
    || die "could not check out origin/$BRANCH"
  log "code $old -> $(git -C "$REPO_DIR" rev-parse --short HEAD) ($BRANCH)"
  export KRS_PULLED=1
  exec "$REPO_DIR/ops/bin/krs-pull-deploy" "${ARGS[@]}"
fi
OPS="$REPO_DIR/ops"

# --- 2. One heavy operation at a time (shared with the deploy scripts) ---
source "$OPS/bin/krs-safety"
krs_lock_or_fail 900 || die "another heavy operation (job / deploy) is still running; try again later"
export KRS_DEPLOYING=1   # headroom checks ignore "app down": a deploy is how a down app gets fixed

# --- 3. Install ops files that changed (atomic replace, so running copies are not disturbed) ---
changed_units=0
put() {  # put <src> <dest> <mode>
  local src=$1 dst=$2 mode=$3
  cmp -s "$src" "$dst" && return 1
  mkdir -p "$(dirname "$dst")"; cp "$src" "$dst.new" && chmod "$mode" "$dst.new" && mv -f "$dst.new" "$dst" && echo "  installed $dst"
}
shopt -s nullglob
mkdir -p "$DEPLOY/finance" /opt/krs/creds /var/backups/krs; chmod 700 /opt/krs/creds /var/backups/krs
for f in "$OPS"/bin/*; do put "$f" "/usr/local/sbin/$(basename "$f")" 755; done
for f in "$OPS"/systemd/*.service "$OPS"/systemd/*.timer; do put "$f" "/etc/systemd/system/$(basename "$f")" 644 && changed_units=1; done
for d in "$OPS"/systemd/*.d; do for f in "$d"/*; do put "$f" "/etc/systemd/system/$(basename "$d")/$(basename "$f")" 644 && changed_units=1; done; done
put "$OPS/deploy/compose.yml" "$DEPLOY/compose.yml" 644
put "$OPS/deploy/finance/compose.yml" "$DEPLOY/finance/compose.yml" 644
# Docker log limits are set per service in the compose files: /etc/docker/daemon.json is shared with other projects
# and changing it needs a Docker restart (= downtime for every container on the host).
if [ $changed_units = 1 ]; then
  systemctl daemon-reload
  systemctl enable -q --now krs-health.timer krs-db-backup.timer
fi
# Routing/TLS: Nginx Proxy Manager proxy hosts (configured once through its UI/API, see docs/NEW-SERVER.md).
# Network shared by the website and finance compose projects (external in both, so neither owns or deletes it)
docker network inspect krs_internal >/dev/null 2>&1 || docker network create krs_internal >/dev/null || die "could not create network krs_internal"

# --- 4. First run only: env files with new random secrets, databases ---
rand() { openssl rand -hex "$1"; }
if [ $INIT = 1 ]; then
  [ -e /opt/krs/creds/ghcr-read.txt ] || die "missing /opt/krs/creds/ghcr-read.txt (GitHub token with read:packages only, mode 600)"
  if [ ! -e "$DEPLOY/.env" ]; then
    ( umask 077; cat > "$DEPLOY/.env" <<EOF
# Website + database (created by krs-pull-deploy --init on $(date -u +%F)). Never commit or paste these values.
POSTGRES_USER=krs_admin
POSTGRES_PASSWORD=$(rand 24)
POSTGRES_DB=krs_db
PAYLOAD_SECRET=$(rand 32)
NEXT_PUBLIC_SITE_URL=$SITE_URL
SYNC_SEED_EVENTS=0
# Email (Gmail App Password), then: sudo docker compose -f $DEPLOY/compose.yml up -d
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM=
EOF
    ); log "created $DEPLOY/.env with new random secrets"
  fi
  for L in official unofficial; do
    f="$DEPLOY/finance/$L.env"; [ -e "$f" ] && continue
    host=$([ $L = official ] && echo finance || echo ledger); name=$([ $L = official ] && echo Official || echo Unofficial)
    ( umask 077; cat > "$f" <<EOF
# Finance portal, $name ledger (created by krs-pull-deploy --init on $(date -u +%F)). Never commit or paste these values.
ENVIRONMENT=production
LEDGER_NAME=$name
DATABASE_URL=postgresql://krs_fin_$L:$(rand 24)@krs-website-postgres:5432/krs_fin_$L
SESSION_SECRET=$(rand 32)
FRONTEND_URL=https://$host.kalamroboticssociety.com
COOKIE_SECURE=true
STORAGE_TYPE=local
ALLOW_LOCAL_STORAGE=true
LOCAL_VAULT_DIR=/app/storage_vault
LOG_DIR=/app/logs
# Accounts: set passwords (12+ characters), then: sudo krs-finance-reload $L
# A password here only CREATES the account; later resets: sudo krs-finance-passwd $L <username>
ACCOUNT_ADMIN_USERNAME=audit
ACCOUNT_ADMIN_PASSWORD=
ACCOUNT_TREASURER_USERNAME=treasurer
ACCOUNT_TREASURER_PASSWORD=
ACCOUNT_PRESIDENT_USERNAME=president
ACCOUNT_PRESIDENT_PASSWORD=
EOF
    ); log "created $f with new random secrets"
  done
  docker compose -f "$DEPLOY/compose.yml" up -d db >/dev/null || die "database container did not start"
  for i in $(seq 1 60); do docker exec krs-website-postgres sh -c 'pg_isready -q -h 127.0.0.1 -U "$POSTGRES_USER"' && break; sleep 2; done
  for L in official unofficial; do   # each ledger gets its own role + database inside the same Postgres
    pw=$(sed -nE 's#^DATABASE_URL=postgresql://[^:]+:([0-9a-f]+)@.*#\1#p' "$DEPLOY/finance/$L.env")
    [ -n "$pw" ] || die "could not read the database password from $DEPLOY/finance/$L.env"
    docker exec -i krs-website-postgres sh -c 'psql -q -v ON_ERROR_STOP=1 -U "$POSTGRES_USER" -d postgres' <<SQL || die "finance database setup failed ($L)"
SELECT 'CREATE ROLE krs_fin_$L LOGIN' WHERE NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname='krs_fin_$L') \gexec
ALTER ROLE krs_fin_$L PASSWORD '$pw';
SELECT 'CREATE DATABASE krs_fin_$L OWNER krs_fin_$L' WHERE NOT EXISTS (SELECT 1 FROM pg_database WHERE datname='krs_fin_$L') \gexec
SQL
  done
  log "init done"
fi

# --- SQL write log (owner, 8 Oct 2026): every INSERT/UPDATE/DELETE/DDL on the KRS Postgres is logged with time, user,
# database, client program and address, except the website's own connection (compose.yml DATABASE_URL options).
# Hand-typed SQL shows its values; bound values of the finance apps' queries are hidden. Kept in the container's
# Docker log (3 x 10 MB). Read: sudo docker logs krs-website-postgres 2>&1 | grep -E 'LOG:  (statement|execute)'
# Stored in postgresql.auto.conf (data volume) and re-applied on every run: reload only, never a restart.
if docker ps --format '{{.Names}}' | grep -qx krs-website-postgres; then
  docker exec -i krs-website-postgres sh -c 'psql -qAt -v ON_ERROR_STOP=1 -U "$POSTGRES_USER" -d postgres' >/dev/null <<'SQL' || log "warning: SQL write log settings not applied"
ALTER SYSTEM SET log_statement = 'mod';
ALTER SYSTEM SET log_parameter_max_length = 0;
ALTER SYSTEM SET log_line_prefix = '%m [%p] %u@%d app=%a client=%h ';
SELECT pg_reload_conf();
SQL
fi

[ $OPS_ONLY = 1 ] && { log "ops files up to date; no images deployed (--ops-only)"; exit 0; }
[ -e "$DEPLOY/.env" ] || die "no $DEPLOY/.env yet: run  sudo krs-pull-deploy --init  first"

# --- 5. Images (krs-deploy / krs-finance-deploy pull through krs-heavy-guard, health-check, roll back on failure) ---
rc=0
if [ "$WEB_TAG" != skip ]; then /usr/local/sbin/krs-deploy "$WEB_TAG" || { rc=1; log "website deploy of $WEB_TAG failed (see above)"; }; fi
if [ "$FIN_TAG" != skip ]; then /usr/local/sbin/krs-finance-deploy "$FIN_TAG" || { rc=1; log "finance deploy of $FIN_TAG failed (see above)"; }; fi
[ $rc = 0 ] && log "done" || log "finished with errors"
exit $rc
