#!/bin/bash
# Deploy a website image built by GitHub Actions:  sudo krs-deploy sha-<full commit sha> | deploy-ready | main
# Usually called by krs-pull-deploy. An image that is already running is not swapped again.
# Pulls from GHCR (read-only token in /opt/krs/creds/ghcr-read.txt), keeps the running image as :prev,
# swaps the container, waits for health, triggers Payload init/migrations, rolls back automatically on failure.
set -u
# Whole deploy holds the shared heavy-work lock (no other heavy job meanwhile); see /usr/local/sbin/krs-safety
source /usr/local/sbin/krs-safety
krs_lock_or_fail 900 || { echo "[deploy] another heavy operation (job) is still running; try again later" >&2; exit 3; }
TAG=${1:?usage: krs-deploy <tag>}
IMG=ghcr.io/ashirogi-muto/krs-website
TOKEN_FILE=/opt/krs/creds/ghcr-read.txt
COMPOSE=/opt/krs/deploy/compose.yml
log() { echo "[krs-deploy] $*"; logger -t krs-health -p user.notice "deploy: $*"; }

[ -r "$TOKEN_FILE" ] || { echo "missing $TOKEN_FILE (classic PAT with read:packages only)" >&2; exit 2; }
head -n1 "$TOKEN_FILE" | tr -d '\r\n' | docker login ghcr.io -u ashirogi-muto --password-stdin >/dev/null 2>&1 \
  || { echo "GHCR login failed" >&2; exit 2; }
/usr/local/sbin/krs-heavy-guard docker pull "$IMG:$TAG"; rc=$?
docker logout ghcr.io >/dev/null 2>&1
[ $rc -eq 0 ] || { log "pull failed or interrupted (rc=$rc) for $TAG"; exit $rc; }

new=$(docker image inspect -f '{{.Id}}' "$IMG:$TAG"); cur=$(docker image inspect -f '{{.Id}}' krs-website:latest 2>/dev/null)
if [ "$new" = "$cur" ] && [ -n "$(docker ps -q -f name=^krs-web$ -f status=running)" ]; then
  docker image rm "$IMG:$TAG" >/dev/null 2>&1 || true
  log "website $TAG is already running; nothing to do"; exit 0
fi
# Back up every database before the new image can run migrations; no backup, no deploy
if [ -n "$(docker ps -q -f name=^krs-website-postgres$ -f status=running)" ]; then
  /usr/local/sbin/krs-db-backup --pre-deploy || { log "pre-deploy backup FAILED - deploy of $TAG cancelled"; docker image rm "$IMG:$TAG" >/dev/null 2>&1 || true; exit 4; }
fi
[ -n "$cur" ] && docker tag krs-website:latest krs-website:prev
docker tag "$IMG:$TAG" krs-website:latest
docker compose -f "$COMPOSE" up -d >/dev/null 2>&1
ok=0; for i in $(seq 1 45); do [ "$(curl -s -o /dev/null -w '%{http_code}' http://127.0.0.1:3003/api/health)" = 200 ] && { ok=1; break; }; sleep 2; done
if [ $ok = 1 ]; then
  curl -s -o /dev/null -m 60 http://127.0.0.1:3003/aurix/register   # first DB request: Payload init + pending migrations
  sleep 3
  if docker logs --since 2m krs-web 2>&1 | grep -qiE "migration.*(fail|error)|cannot connect to postgres"; then ok=0; fi
  [ "$(curl -s -o /dev/null -w '%{http_code}' http://127.0.0.1:3003/aurix/register)" = 200 ] || ok=0
fi
if [ $ok = 1 ]; then
  # Pages in the image were pre-built without the database: clear the page cache so every next visit renders from
  # the CMS (token = sha256 of "krs-revalidate:" + PAYLOAD_SECRET from the server's .env; never printed
  # or put on a command line: the header is passed through a file descriptor)
  secret=$(sed -n 's/^PAYLOAD_SECRET=//p' /opt/krs/deploy/.env | head -n1 | tr -d '\r"'"'"'')
  if [ -n "$secret" ]; then
    tok=$(printf 'krs-revalidate:%s' "$secret" | sha256sum | cut -d' ' -f1)
    [ "$(curl -s -o /dev/null -w '%{http_code}' -m 20 -X POST -H @<(printf 'x-krs-revalidate: %s\n' "$tok") http://127.0.0.1:3003/api/internal/revalidate)" = 200 ] \
      && log "page cache cleared" || log "page cache NOT cleared (pages refresh within a minute instead)"
  fi
  unset secret tok
  log "deployed $TAG (rollback image: krs-website:prev)"
  docker image rm "$IMG:$TAG" >/dev/null 2>&1 || true   # keep only local krs-website:{latest,prev}
  exit 0
fi
if [ -z "$cur" ]; then log "first deploy of $TAG UNHEALTHY (nothing to roll back to) - see: docker logs krs-web"; exit 1; fi
log "deploy of $TAG UNHEALTHY - rolling back to krs-website:prev"
docker tag krs-website:prev krs-website:latest
docker compose -f "$COMPOSE" up -d >/dev/null 2>&1
exit 1
