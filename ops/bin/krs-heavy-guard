#!/bin/bash
# Run a heavy job (image pull, prune, restore) only with headroom, and stop it before it can hurt the server.
#   usage: krs-heavy-guard <command> [args...]
# Rules (after the 2-3 Oct 2026 outage), all in /usr/local/sbin/krs-safety:
#   - one heavy KRS operation at a time (shared lock with deploys)
#   - start only with headroom: memory < 70%, load < 70%, IO pressure < 20%, CPU steal < 20% (host not busy),
#     disk >= 10 GB free
#   - stop the job if memory reaches 80%, IO stalls >= 50%, memory stalls >= 10% or disk < 8 GB
set -u
source /usr/local/sbin/krs-safety
[ $# -ge 1 ] || { echo "usage: krs-heavy-guard <command> [args...]" >&2; exit 2; }
krs_lock_or_fail 0 || { echo "[krs-heavy-guard] refusing to start: another heavy operation is running" >&2; exit 3; }
if ! why=$(krs_preflight); then
  echo "[krs-heavy-guard] refusing to start, not enough headroom:" >&2; echo "$why" >&2
  logger -t krs-health "WARN heavy-guard refused ($(echo "$why" | head -1)): $*"
  exit 3
fi
logger -t krs-health -p user.notice "heavy job started: $*"
nice -n 15 ionice -c 2 -n 7 "$@" &
pid=$!; strikes=0
while kill -0 $pid 2>/dev/null; do
  sleep 5
  reason=$(krs_watch_reason)
  if [ -n "$reason" ]; then strikes=$((strikes+1)); else strikes=0; fi
  if [ $strikes -ge 2 ]; then
    logger -t krs-health -p user.crit "heavy job INTERRUPTED ($reason): $*"
    echo "[krs-heavy-guard] interrupting job: $reason" >&2
    kill -INT $pid; sleep 10; kill -TERM $pid 2>/dev/null; wait $pid; exit 4
  fi
done
wait $pid; rc=$?
logger -t krs-health -p user.notice "heavy job finished rc=$rc: $*"
exit $rc
