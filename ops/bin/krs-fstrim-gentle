#!/bin/bash
# Gentle TRIM of / on thin-provisioned host storage: returns blocks freed inside the VM to the host's pool.
# Runs nightly (krs-fstrim-gentle.timer) and whenever too much has been written since the last TRIM.
# - takes the shared heavy-work lock: no image pull / deploy / job can start while it runs, and it waits for them
# - 256 MB slices with pauses; waits while IO pressure or memory/CPU load is high; gives up after 3 h
set -u
source /usr/local/sbin/krs-safety
krs_lock_or_fail 1800 || { logger -t krs-health "WARN TRIM skipped: heavy operation still running after 30 min"; exit 0; }
SLICE=$((256 * 1024 * 1024)); total=$(df -B1 --output=size / | tail -1); off=0; slices=0; trimmed=0; start=$(date +%s)
logger -t krs-health -p user.notice "gentle TRIM started ($(krs_written_since_trim_gb) GB written since last TRIM)"
while [ $off -lt $total ]; do
  if [ $(( $(date +%s) - start )) -gt 10800 ]; then logger -t krs-health "WARN TRIM stopped after 3 h at slice $slices"; exit 0; fi
  if [ "$(_psi io some)" -ge 20 ] || [ "$(_mem_used_pct)" -ge 80 ] || [ "$(_load_pct)" -ge 80 ]; then sleep 20; continue; fi
  out=$(fstrim -v -o $off -l $SLICE / 2>/dev/null) && trimmed=$(( trimmed + $(echo "$out" | grep -oE '\(([0-9]+) bytes\)' | tr -dc 0-9 || echo 0) ))
  off=$((off + SLICE)); slices=$((slices + 1)); sleep 2
done
krs_mark_trimmed
logger -t krs-health -p user.notice "gentle TRIM finished: $slices slices, $((trimmed / 1048576)) MB returned to the host in $(( $(date +%s) - start )) s"
