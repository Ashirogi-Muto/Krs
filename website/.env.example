# ==============================================================================
# Kalam Robotics Society (KRS) & AURIX Digital Platform — Environment Configuration
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=3003
HOSTNAME=0.0.0.0
NEXT_PUBLIC_SITE_URL=http://localhost:3003

# Database Configuration (Dedicated PostgreSQL container on port 5434)
# Form: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://krs_admin:krs_secure_dev_pass_2026@127.0.0.1:5434/krs_db
POSTGRES_USER=krs_admin
POSTGRES_PASSWORD=krs_secure_dev_pass_2026
POSTGRES_DB=krs_db

# Payload CMS Secret (Generate with: openssl rand -base64 32)
PAYLOAD_SECRET=replace_with_min_32_byte_cryptographically_secure_random_key_in_production

# SEO & Search Engine Verification
GOOGLE_SITE_VERIFICATION=your_google_search_console_token_here

# Analytics Abstraction (Optional)
NEXT_PUBLIC_ANALYTICS_ID=

# Email (SMTP; Gmail with a Google App Password in production). Never commit real values.
# Until MAIL_USERNAME and MAIL_PASSWORD are set, confirmation emails wait in the CMS "Email outbox".
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME="AURIX 2026 · Kalam Robotics Society"
MAIL_REPLY_TO=
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_STARTTLS=true
# Pacing: one email per MAIL_INTERVAL_SECONDS, only inside MAIL_SEND_WINDOW (IST, or "always"),
# outside it only when MAIL_BACKLOG_OVERRIDE emails are waiting; at most MAIL_DAILY_LIMIT per 24 h.
MAIL_INTERVAL_SECONDS=60
MAIL_SEND_WINDOW=17:00-09:00
MAIL_BACKLOG_OVERRIDE=150
MAIL_DAILY_LIMIT=450
# EMAIL_WORKER=0 disables the background sender (e.g. for one-off CLI runs)

# Payment Gateway Configuration (Abstracted: Mock / Razorpay / Cashfree)
# Options: mock | razorpay | cashfree (Mock strictly prohibited from confirming production registrations)
PAYMENT_PROVIDER=mock
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=

# S3-Compatible Media Object Storage (Backblaze B2 / Cloudflare R2 / AWS S3 / MinIO)
# Options: local | s3 (Defaults to "local" for local development)
STORAGE_PROVIDER=local
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
