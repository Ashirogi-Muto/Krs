# ==============================================================================
# Kalam Robotics Society (KRS) Financial Management - Environment Variables Template
# Copy this file to .env before starting the services.
# NEVER commit .env to version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration
# ------------------------------------------------------------------------------
# Environment: 'development' or 'production'
# In production, default insecure secret keys will intentionally halt server startup!
APP_ENV=development
APP_NAME="KRS Financial Management API"

# Cryptographic Secret Key (Must be at least 32 characters in production)
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change_this_to_a_secure_random_string_minimum_32_characters

# JWT Expiry in minutes (default: 480 = 8 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database Connection URL
# For local SQLite development:
DATABASE_URL=sqlite:///./krs_financial.db
# For production PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/krs_financial

# CORS & Cookie Security
# Comma-separated list of allowed frontend origins:
ALLOWED_ORIGINS=http://localhost:3050,http://127.0.0.1:3050
# Set COOKIE_SECURE=True in production (HTTPS), False for local HTTP:
COOKIE_SECURE=False

# Storage Provider Configuration: 'local' or 's3'
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./storage_vault

# S3 / Cloudflare R2 / Backblaze B2 (Required only when STORAGE_PROVIDER=s3)
S3_BUCKET_NAME=krs-financial-vault
S3_REGION=auto
S3_ACCESS_KEY_ID=your_s3_or_r2_access_key_id
S3_SECRET_ACCESS_KEY=your_s3_or_r2_secret_access_key
S3_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com

# ------------------------------------------------------------------------------
# Frontend Configuration
# ------------------------------------------------------------------------------
# Set the backend URL if running separate hostnames without Next.js proxy
NEXT_PUBLIC_API_URL=http://localhost:8050
