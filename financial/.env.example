# ==============================================================================
# KRS Financial Management — environment variables (names match backend/app/config.py)
# Copy to a file OUTSIDE the repository (mode 600). NEVER commit real values.
# ==============================================================================

# development | testing | production  (production enables strict startup validation)
ENVIRONMENT=development

# 32+ random characters, e.g.: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=change_me_to_a_long_random_value

SESSION_EXPIRE_HOURS=12
# Leave empty to auto-enable Secure cookies when ENVIRONMENT=production
COOKIE_SECURE=

# Public URL of the frontend (used for CORS)
FRONTEND_URL=http://localhost:3050

# SQLite only for local development; production requires PostgreSQL
DATABASE_URL=sqlite:///./krs_financial.db
# DATABASE_URL=postgresql://user:password@host:5432/krs_financial

# Document storage: local | s3
STORAGE_TYPE=local
# Production only: explicit opt-in to keep documents on the server until S3-compatible storage exists
ALLOW_LOCAL_STORAGE=false
LOCAL_VAULT_DIR=./vault
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=auto

# One-time admin creation (python -m app.bootstrap_admin or app.seed); never commit these
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Set to 1 only to load demo transactions into a development database
SEED_SAMPLE_DATA=0

# Frontend build: where the Next.js rewrite sends /api when nginx is not in front
API_INTERNAL_URL=http://127.0.0.1:8050
